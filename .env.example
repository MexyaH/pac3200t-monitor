# Copia questo file in `.env` e compila i valori:
#   cp .env.example .env
# Il file `.env` e' in .gitignore: non finisce nel repository.

# Connessione a un PostgreSQL esistente. Lo stack non include Postgres.
# Se Postgres gira in un container sulla stessa rete Docker, usa il nome
# del container come host e la porta INTERNA (di solito 5432).
DATABASE_URL=postgres://utente:password@postgres:5432/database

# Schema in cui il poller crea le sue tabelle. Cambialo solo se `pac`
# e' gia' usato nel database.
DB_SCHEMA=pac

# Rete Docker esterna (gia' esistente) a cui si collegano i container.
# Deve essere la stessa del container Postgres.
DOCKER_NETWORK=pacnet

# Anagrafica contatori caricata all'avvio (percorso dentro il container).
# Lascia vuoto per inserire i contatori solo a mano nel database.
#   /app/db/devices-example.csv  esempio da adattare
#   /app/db/devices-local.csv    contatori simulati (profilo `sim`)
DEVICES_CSV=/app/db/devices-example.csv

# Porta dell'host su cui e' pubblicata la dashboard.
API_PORT=8080

# Login della dashboard. Con ADMIN_PASSWORD impostata serve l'accesso per
# vedere e modificare; vuota = dashboard visibile a tutti, modifica
# disabilitata. Cambiare la password chiude tutte le sessioni aperte.
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# Stringa casuale lunga, consigliata (es. `openssl rand -hex 32`).
#   - su Windows: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
#   - su Linux: openssl rand -hex 32
#   - con Node: docker compose run --rm --entrypoint node api -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SESSION_SECRET=
